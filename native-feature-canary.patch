@@ -0,0 +1,71 @@
+//! Tiny native feature canary used to measure C++ edit/rebuild behavior.
+
+/// Deterministic native decision returned by the canary implementation.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum FeatureDecision {
+    Disabled,
+    Enabled,
+}
+
+impl FeatureDecision {
+    /// Returns whether this decision enables the canary feature.
+    pub fn is_enabled(self) -> bool {
+        matches!(self, Self::Enabled)
+    }
+}
+
+/// Returns the native canary decision for a feature key.
+///
+/// This is intentionally small and deterministic so it can be used to verify
+/// whether edits to C++ feature code rebuild only the native object and final
+/// dependent link steps.
+pub fn decision_for_key(key: &str) -> FeatureDecision {
+    let raw = unsafe { codex_native_feature_canary_decision(key.as_ptr(), key.len()) };
+    match raw {
+        0 => FeatureDecision::Disabled,
+        1 => FeatureDecision::Enabled,
+        unexpected => panic!("native feature canary returned unexpected decision {unexpected}"),
+    }
+}
+
+/// Returns the stable native hash for a feature key.
+pub fn stable_hash_for_key(key: &str) -> u32 {
+    unsafe { codex_native_feature_canary_hash(key.as_ptr(), key.len()) }
+}
+
+unsafe extern "C" {
+    fn codex_native_feature_canary_decision(key: *const u8, len: usize) -> u32;
+    fn codex_native_feature_canary_hash(key: *const u8, len: usize) -> u32;
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    fn explicit_prefixes_override_hash_gate() {
+        assert_eq!(
+            decision_for_key("force-on:feature:x"),
+            FeatureDecision::Enabled
+        );
+        assert_eq!(
+            decision_for_key("force-off:feature:small"),
+            FeatureDecision::Disabled
+        );
+    }
+
+    #[test]
+    fn hash_gate_uses_native_implementation() {
+        assert_eq!(
+            stable_hash_for_key("feature:context-reduction"),
+            0xfb18_345c
+        );
+        assert_eq!(
+            decision_for_key("feature:context-reduction"),
+            FeatureDecision::Disabled
+        );
+        assert_eq!(stable_hash_for_key("feature:small"), 0x4fc3_e5cc);
+        assert_eq!(decision_for_key("feature:small"), FeatureDecision::Enabled);
+    }
+}
diff --git a/codex-rs/native-feature-canary/src/native/canary.cpp b/codex-rs/native-feature-canary/src/native/canary.cpp
new file mode 100644
index 0000000000..ccd64e5ce9
--- /dev/null
+++ b/codex-rs/native-feature-canary/src/native/canary.cpp
@@ -0,0 +1,62 @@
+#include "canary.h"
+
+namespace {
+
+constexpr uint32_t kFnvOffset = 2166136261u;
+constexpr uint32_t kFnvPrime = 16777619u;
+constexpr uint32_t kBucketCount = 100u;
+
+template <size_t N>
+bool has_prefix(const uint8_t *data, size_t len, const char (&prefix)[N]) noexcept {
+    constexpr size_t prefix_len = N - 1;
+    if (len < prefix_len) {
+        return false;
+    }
+
+    for (size_t i = 0; i < prefix_len; ++i) {
+        if (data[i] != static_cast<uint8_t>(prefix[i])) {
+            return false;
+        }
+    }
+
+    return true;
+}
+
+uint32_t fnv1a(const uint8_t *data, size_t len) noexcept {
+    uint32_t hash = kFnvOffset;
+    for (size_t i = 0; i < len; ++i) {
+        hash ^= data[i];
+        hash *= kFnvPrime;
+    }
+    return hash;
+}
+
+}  // namespace
+
+extern "C" uint32_t codex_native_feature_canary_hash(
+    const uint8_t *key,
+    size_t len) {
+    if (key == nullptr && len != 0) {
+        return 0;
+    }
+
+    return fnv1a(key, len);
+}
+
+extern "C" uint32_t codex_native_feature_canary_decision(
+    const uint8_t *key,
+    size_t len) {
+    if (key == nullptr && len != 0) {
+        return 0;
+    }
+
+    if (has_prefix(key, len, "force-on:")) {
+        return 1;
+    }
+
+    if (has_prefix(key, len, "force-off:")) {
+        return 0;
+    }
+
+    return fnv1a(key, len) % kBucketCount < 50 ? 1 : 0;
+}
