             if let TurnItem::AgentMessage(agent_message) = &item {
                 let message = agent_message
                     .content
                     .iter()
                     .map(|content| match content {
                         AgentMessageContent::Text { text } => text.as_str(),
                     })
                     .collect::<Vec<_>>()
                     .join("\n");
                 self.services
                     .blackboard
                     .record_assistant_proposal(turn_context.cwd.as_path(), &message)
                     .await;
